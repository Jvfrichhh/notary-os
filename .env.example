# === Database (Supabase PostgreSQL) ===
# Ambil dari Supabase Project Settings > Database > Connection string (URI, mode: Transaction / pgbouncer)
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"
# Direct connection (dipakai Prisma Migrate, tanpa pgbouncer)
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# === Auth.js ===
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="ganti-dengan-hasil-openssl-rand-base64-32"

# === File Storage ===
# "local" untuk development, "r2" untuk production
STORAGE_PROVIDER="local"
LOCAL_STORAGE_PATH="./storage"
# Batas ukuran upload dokumen (MB). Dicek server-side di setiap upload/versi baru.
MAX_UPLOAD_SIZE_MB="20"

# Cloudflare R2 (dipakai jika STORAGE_PROVIDER=r2)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="notary-os-documents"
R2_PUBLIC_URL=""

# === Domain terpisah untuk Portal Klien (opsional) ===
# Jika PORTAL_HOST diset, host tersebut melayani portal klien ("/" -> /portal,
# "/login" -> /portal/login) dan host kantor menolak /portal/**. Kosongkan untuk
# mode satu domain (portal di /portal). Hostname saja, tanpa https://; boleh
# beberapa dipisah koma (domain kustom + domain vercel).
PORTAL_HOST=""
STAFF_HOST=""

# === Supabase Storage sebagai penyimpanan dokumen (STORAGE_PROVIDER=supabase) ===
# Buat bucket privat (mis. notary-documents) dan S3 Access Key di
# Supabase -> Project Settings -> Storage -> S3 Access Keys.
SUPABASE_PROJECT_REF=""
SUPABASE_S3_REGION="ap-southeast-1"
SUPABASE_STORAGE_BUCKET="notary-documents"
SUPABASE_S3_ACCESS_KEY_ID=""
SUPABASE_S3_SECRET_ACCESS_KEY=""

# === Fitur AI (opsional; sisi kantor saja) ===
# Kosongkan semua kunci untuk mematikan fitur AI (tombol & menu tidak tampil).
# Pilih salah satu penyedia:
#  - Gemini (Google): ada tingkat GRATIS, tetapi data boleh dipakai Google ->
#    untuk pengembangan/demo dengan dokumen contoh. Kunci: https://aistudio.google.com
#  - Anthropic: berbayar, data API tidak dipakai pelatihan -> untuk dokumen
#    klien sungguhan. Kunci: https://console.anthropic.com
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""
# Paksa penyedia ("gemini" | "anthropic"); kosong = otomatis (Anthropic bila ada kuncinya, lalu Gemini).
AI_PROVIDER=""
# Model; kosong = default penyedia (gemini-3.8-flash / claude-sonnet-5-5).
AI_MODEL=""
